generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VacancyStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

model Vacancy {
  id             String         @id @default(uuid()) @db.Uuid
  title          String         @db.VarChar(255)
  description    String         @db.Text
  tenantId       String         @map("tenant_id") @db.Uuid
  recruiterId    String         @map("recruiter_id") @db.Uuid
  employmentType EmploymentType @map("employment_type")
  workMode       WorkMode       @map("work_mode")
  closingDate    DateTime       @map("closing_date")
  status         VacancyStatus  @default(DRAFT)
  salary         Decimal?       @db.Decimal(12, 2)
  location       String?        @db.VarChar(255)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([recruiterId])
  @@index([status])
  @@map("vacancies")
}

enum TenantType {
  PLATFORM
  CUSTOMER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(255)
  slug        String       @unique @db.VarChar(100)
  type        TenantType
  status      TenantStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  suspendedAt DateTime?    @map("suspended_at")

  vacancies          Vacancy[]
  users              User[]
  roleConfigurations TenantRoleConfiguration[]
  roleTenants        RoleTenant[]
  invitations        Invitation[]

  @@index([status])
  @@map("tenants")
}

enum InvitationStatus {
  PENDING
  USED
  REVOKED
  EXPIRED
}

model Invitation {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  recipient String           @db.VarChar(255)
  mechanism String           @db.VarChar(50)
  token     String           @unique @db.VarChar(255)
  expiresAt DateTime         @map("expires_at")
  status    InvitationStatus @default(PENDING)
  usedAt    DateTime?        @map("used_at")
  revokedAt DateTime?        @map("revoked_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([recipient])
  @@index([expiresAt])
  @@index([status])
  @@map("invitations")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id String @id @default(uuid()) @db.Uuid

  firstName String @map("first_name") @db.VarChar(100)
  lastName  String @map("last_name") @db.VarChar(100)

  email String @unique @db.VarChar(255)

  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  roleId String @map("role_id") @db.Uuid

  status UserStatus @default(ACTIVE)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  suspendedAt DateTime? @map("suspended_at")

  @@index([tenantId])
  @@index([roleId])
  @@index([status])
  @@map("users")
}

enum RoleScope {
  PLATFORM
  TENANT
}

model Role {
  id                 String    @id @default(uuid()) @db.Uuid
  code               String    @unique @db.VarChar(100)
  defaultDisplayName String    @map("default_display_name") @db.VarChar(100)
  description        String    @db.Text
  scope              RoleScope
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  permissions          Permission[]
  tenantConfigurations TenantRoleConfiguration[]
  rolePermissions      RolePermission[]
  roleTenants          RoleTenant[]

  @@map("roles")
}

enum PermissionScope {
  PLATFORM
  TENANT
}

model Permission {
  id          String          @id @default(uuid()) @db.Uuid
  code        String          @unique @db.VarChar(150)
  description String          @db.Text
  scope       PermissionScope
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  roles           Role[]
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RoleTenant {
  id        String   @id @default(uuid()) @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role   Role   @relation(fields: [roleId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([roleId, tenantId])
  @@index([roleId])
  @@index([tenantId])
  @@map("role_tenants")
}

model TenantRoleConfiguration {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  displayName String   @map("display_name") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([tenantId, roleId])
  @@index([tenantId])
  @@index([roleId])
  @@map("tenant_role_configurations")
}

model AuthenticationAccount {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  provider      String   @db.VarChar(100)
  email         String   @db.VarChar(255)
  emailVerified Boolean  @default(false) @map("email_verified")
  passwordHash  String?  @map("password_hash") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions           AuthenticationSession[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]

  @@index([email])
  @@index([provider])
  @@map("authentication_accounts")
}

model AuthenticationSession {
  id                      String    @id @default(uuid()) @db.Uuid
  authenticationAccountId String    @map("authentication_account_id") @db.Uuid
  refreshTokenHash        String    @map("refresh_token_hash") @db.Text
  expiresAt               DateTime  @map("expires_at")
  refreshTokenExpiresAt   DateTime  @map("refresh_token_expires_at")
  revokedAt               DateTime? @map("revoked_at")
  lastUsedAt              DateTime? @map("last_used_at")
  ipAddress               String?   @map("ip_address") @db.VarChar(45)
  userAgent               String?   @map("user_agent") @db.Text
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  authenticationAccount AuthenticationAccount @relation(fields: [authenticationAccountId], references: [id])

  @@index([authenticationAccountId])
  @@index([expiresAt])
  @@index([refreshTokenHash])
  @@map("authentication_sessions")
}

model EmailVerification {
  id                      String    @id @default(uuid()) @db.Uuid
  authenticationAccountId String    @map("authentication_account_id") @db.Uuid
  email                   String    @db.VarChar(320)
  tokenHash               String    @map("token_hash") @db.VarChar(255)
  expiresAt               DateTime  @map("expires_at")
  verifiedAt              DateTime? @map("verified_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  authenticationAccount AuthenticationAccount @relation(fields: [authenticationAccountId], references: [id])

  @@index([authenticationAccountId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("email_verifications")
}

model PasswordReset {
  id                      String    @id @default(uuid()) @db.Uuid
  authenticationAccountId String    @map("authentication_account_id") @db.Uuid
  tokenHash               String    @map("token_hash") @db.VarChar(255)
  expiresAt               DateTime  @map("expires_at")
  usedAt                  DateTime? @map("used_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  authenticationAccount AuthenticationAccount @relation(fields: [authenticationAccountId], references: [id])

  @@index([authenticationAccountId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_resets")
}
